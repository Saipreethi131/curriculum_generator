# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

# Groq Cloud API Key (Required for fast generation)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Flask Secret Key (REQUIRED for session management and security)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_random_secret_key_here_minimum_32_chars

# Optional: Environment (development, production, testing)
# FLASK_ENV=development

# MongoDB connection string (Phase 1 persistent storage)
# MONGO_URI=mongodb://localhost:27017/curriculum_generator

# Optional: Force HTTPS (set to 'true' in production)
# FORCE_HTTPS=false


